#!/bin/bash
# sms-ondemand - Send iMessage/SMS on-demand, signing in only when needed then optionally signing out
# Usage: sms-ondemand <phone> <message> [--stay|--isolate]
#   --stay : stay signed in after sending (default: stay logged in but quiet)
#   --isolate : sign out after sending (isolated mode)
# Privacy: one-time, does not store credentials or numbers
set -euo pipefail

# Detect --stay/--isolate flags first (before phone): default stay=1 (stay logged in but quiet)
stay=1
if [[ "${@: -1}" == "--stay" ]]; then
  stay=1
  set -- "${@:1:$(($#-1))}"
elif [[ "${@: -1}" == "--isolate" ]]; then
  stay=0
  set -- "${@:1:$(($#-1))}"
fi

if [[ $# -lt 1 ]]; then
  echo "Usage: sms-ondemand <phone> <message> [--stay|--isolate]" >&2
  echo "  Example: sms-ondemand 3233046084 \"Hello\" --stay" >&2
  exit 1
fi

phone_raw="$1"; shift
body="$*"

if [[ -z "$body" ]]; then
  echo "Usage: sms-ondemand <phone> <message> [--stay|--isolate]" >&2
  echo "  Example: sms-ondemand 3233046084 \"Hello\"" >&2
  exit 1
fi

# Normalize phone
phone="$(echo "$phone_raw" | tr -d ' -()')"
if [[ "$phone" =~ ^[0-9]{10}$ ]]; then phone="+1$phone"
elif [[ "$phone" =~ ^1[0-9]{10}$ ]]; then phone="+$phone"
fi

db="$HOME/Library/Accounts/Accounts4.sqlite"
is_active() {
  sqlite3 "$db" "SELECT ZACTIVE FROM ZACCOUNT WHERE ZACCOUNTTYPE=(SELECT Z_PK FROM ZACCOUNTTYPE WHERE ZACCOUNTTYPEDESCRIPTION='Messages') LIMIT 1" 2>/dev/null | grep -q "1"
}

# Check Messages sign-in status
if ! is_active; then
  echo "Messages is currently SIGNED OUT (isolated mode)." >&2
  echo "Opening Messages - please sign in with your Apple ID (password + 2FA)..." >&2
  # Ensure Messages is frontmost and Settings is visible (so you don't have to switch apps)
  osascript -e 'tell application "Messages" to activate' >/dev/null 2>&1 || open -a Messages 2>/dev/null || true
  sleep 0.5
  osascript -e 'tell application "System Events" to set frontmost of process "Messages" to true' >/dev/null 2>&1 || true
  sleep 0.3
  # Open Settings to iMessage tab
  osascript -e 'tell application "System Events" to tell process "Messages" to try click menu item "Settings…" of menu "Messages" of menu bar 1' >/dev/null 2>&1 || true
  sleep 0.5
  osascript -e 'tell application "Messages" to activate' -e 'tell application "System Events" to set frontmost of process "Messages" to true' >/dev/null 2>&1 || true
  sleep 0.5
  echo "Waiting for sign-in (checking every 2s, timeout 120s)..." >&2
  for i in $(seq 1 60); do
    if is_active; then
      echo "✓ Messages is now signed in" >&2
      sleep 1
      break
    fi
    sleep 2
    if [[ $((i % 5)) -eq 0 ]]; then
      echo "  Still waiting... ($((i*2))s) - sign in via Messages > Settings > iMessage" >&2
    fi
  done
  if ! is_active; then
    echo "Timed out waiting for sign-in. Please sign in manually via Messages > Settings > iMessage, then rerun." >&2
    exit 1
  fi
else
  echo "Messages is signed in, proceeding..." >&2
fi

# Send via sms-auto if available, else via AppleScript directly
# When stay==1 (default) we stay logged in; when stay==0 (--isolate) we sign out after.
if [[ $stay -eq 0 ]]; then
  # --isolate: send then sign out (do not exec, so sign-out logic can run)
  if [[ -x "$HOME/Projects/dotfiles/bin/sms-auto" ]]; then
    "$HOME/Projects/dotfiles/bin/sms-auto" "$phone" "$body"
  elif command -v sms-auto >/dev/null 2>&1; then
    sms-auto "$phone" "$body"
  else
    # Fallback inline
    osascript 2>&1 <<EOF
tell application "Messages"
  try
    set svc to 1st service whose service type = iMessage
    send "$body" to buddy "$phone" of svc
    return "sent iMessage"
  on error
    set svc2 to 1st service whose service type = SMS
    send "$body" to buddy "$phone" of svc2
    return "sent SMS"
  end try
end tell
EOF
  fi
  sqlite3 "$db" "UPDATE ZACCOUNT SET ZACTIVE=0, ZAUTHENTICATED=0 WHERE ZACCOUNTTYPE=(SELECT Z_PK FROM ZACCOUNTTYPE WHERE ZACCOUNTTYPEDESCRIPTION='Messages')" 2>/dev/null || true
  killall imagent 2>/dev/null || true
  killall accountsd 2>/dev/null || true
  pkill -x Messages 2>/dev/null || true
  echo "Messages signed out again (isolated)." >&2
else
  echo "Staying signed in (phone-only, notifications off)" >&2
  if [[ -x "$HOME/Projects/dotfiles/bin/sms-auto" ]]; then
    exec "$HOME/Projects/dotfiles/bin/sms-auto" "$phone" "$body"
  elif command -v sms-auto >/dev/null 2>&1; then
    exec sms-auto "$phone" "$body"
  else
    # Fallback inline
    osascript 2>&1 <<EOF
tell application "Messages"
  try
    set svc to 1st service whose service type = iMessage
    send "$body" to buddy "$phone" of svc
    return "sent iMessage"
  on error
    set svc2 to 1st service whose service type = SMS
    send "$body" to buddy "$phone" of svc2
    return "sent SMS"
  end try
end tell
EOF
  fi
fi
