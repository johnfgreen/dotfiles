#!/usr/bin/env zsh
# ghostty-tmux — wrapper for Ghostty `command` to auto-attach to tmux
# Guards against nesting: if already inside tmux, just exec a login shell.
# Used by: config/ghostty/config.ghostty  ->  command = /Users/john/Projects/dotfiles/bin/ghostty-tmux
# Bypass for one window:  ghostty --command=/bin/zsh  OR  open -na Ghostty --args --command=/bin/zsh
set -euo pipefail

TMUX_BIN="/opt/homebrew/bin/tmux"
SESSION="main"

# If already inside tmux, don't nest — just exec login shell
if [[ -n "${TMUX:-}" ]]; then
  exec "${SHELL:-/bin/zsh}" -l
fi

# If tmux binary missing, fallback to shell
if [[ ! -x "$TMUX_BIN" ]]; then
  echo "ghostty-tmux: $TMUX_BIN not found, falling back to \$SHELL" >&2
  exec "${SHELL:-/bin/zsh}" -l
fi

# Auto-attach/create. -A = attach if exists, else create. -s = session name
exec "$TMUX_BIN" new-session -A -s "$SESSION"
