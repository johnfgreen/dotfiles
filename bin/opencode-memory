#!/usr/bin/env python3
"""
opencode-memory — Persistent memory for opencode agents.

Usage:
  opencode-memory status              Show current memory state
  opencode-memory init                Initialize memory file if missing
  opencode-memory add-task <desc>     Add a new objective (--priority high|medium|low)
  opencode-memory update-task <id>    Update task status/notes (--status, --notes)
  opencode-memory complete-task <id>  Mark task completed (--result "...")
  opencode-memory add-note <text>     Add a context note
  opencode-memory get-context         Print a compact summary for session restore
  opencode-memory heartbeat           Update last_updated timestamp only
  opencode-memory close               Finalize session (set last_session_end)
  opencode-memory prune               Manually trim old completed tasks and notes
                                 (limits: 100 tasks, 20 notes)
                                 (env: OPCODE_MEMORY_MAX_COMPLETED / MAX_NOTES)
  opencode-memory archive             Move all active objectives to completed (start fresh, keep history)
  opencode-memory forget              Permanently delete all active objectives (no history kept)

Per-agent memory:
  opencode-memory --agent <name> <command> [args...]
  opencode-memory --memory <path> <command> [args...]

  Env vars (override defaults, CLI flags override env):
    OPCODE_MEMORY_PATH  — explicit path to memory JSON
    OPCODE_AGENT        — agent name (e.g. system, inclusion-specialist)
                         resolves to ~/.config/opencode/agents/<agent>-memory.json
                         ("system" → system-memory.json for backward compat)

  Examples:
    opencode-memory status
    opencode-memory --agent inclusion-specialist status
    opencode-memory --agent inclusion-specialist add-task "Draft UDL checklist" --priority high
    OPCODE_AGENT=inclusion-specialist opencode-memory get-context
    opencode-memory --memory ./.opencode/memory.json status

  Auto-detection (no flag needed):
    - If CWD is ~/Projects/inclusion-specialist (or any parent contains
      .opencode/agents/inclusion-specialist.md or opencode.jsonc with it),
      defaults to inclusion-specialist memory.
    - Otherwise checks opencode session DB for recent agent in this directory.
    - Falls back to system agent ( ~/.config/opencode/agents/system-memory.json ).
    - Disable with OPCODE_AUTO_DETECT=0.

  Shell integration (dotfiles home/.zshrc):
    - `opencode --agent X` wrapper exports OPCODE_AGENT=X
    - chpwd hook sets OPCODE_AGENT=inclusion-specialist when entering
      ~/Projects/inclusion-specialist, clears on leave.
    - direnv: .envrc in inclusion-specialist project does the same.
"""

import json
import os
import sys
from datetime import datetime, timezone

# Pruning limits (configurable via env vars)
MAX_COMPLETED_TASKS = int(os.environ.get("OPCODE_MEMORY_MAX_COMPLETED", "100"))
MAX_CONTEXT_NOTES = int(os.environ.get("OPCODE_MEMORY_MAX_NOTES", "20"))

DEFAULT_MEMORY_PATH = os.path.expanduser("~/.config/opencode/agents/system-memory.json")
AGENT_MEMORY_TEMPLATE = os.path.expanduser("~/.config/opencode/agents/{agent}-memory.json")

# Will be resolved in main() before loading
MEMORY_PATH = DEFAULT_MEMORY_PATH

SHELL = {
    "schema_version": 1,
    "last_updated": "",
    "session_count": 0,
    "active_objectives": [],
    "completed_tasks": [],
    "context_notes": [],
    "working_directory": os.path.expanduser("~"),
    "last_session_end": "",
}


def _now():
    return datetime.now(timezone.utc).isoformat()


def _auto_detect_agent():
    """Try to infer agent from PWD, project config, or recent opencode session.
    Returns agent name or None."""
    # Allow disabling via env
    if os.environ.get("OPCODE_AUTO_DETECT", "1") == "0":
        return None
    try:
        cwd = os.getcwd()
    except Exception:
        return None

    # 1. Direct PWD match for known projects
    inclusion_path = os.path.expanduser("~/Projects/inclusion-specialist")
    if cwd == inclusion_path or cwd.startswith(inclusion_path + os.sep):
        return "inclusion-specialist"

    # 2. Walk up looking for opencode.jsonc or .opencode/agents marker
    cur = cwd
    for _ in range(12):
        # Check opencode.jsonc in this dir
        candidate = os.path.join(cur, "opencode.jsonc")
        if os.path.exists(candidate):
            try:
                with open(candidate, "r") as f:
                    content = f.read()
                    if "inclusion-specialist" in content:
                        return "inclusion-specialist"
            except Exception:
                pass
        # Check .opencode/agents/inclusion-specialist.md
        agent_marker = os.path.join(cur, ".opencode", "agents", "inclusion-specialist.md")
        if os.path.exists(agent_marker):
            return "inclusion-specialist"
        # Check for project-local memory file hint
        if os.path.exists(os.path.join(cur, ".opencode", "memory.json")):
            # If this project has its own memory.json and also global inclusion memory exists, prefer inclusion
            if os.path.exists(os.path.expanduser("~/.config/opencode/agents/inclusion-specialist-memory.json")):
                # Only return if this dir looks like inclusion-specialist (avoid false positives for other projects)
                if "inclusion-specialist" in cur:
                    return "inclusion-specialist"
        parent = os.path.dirname(cur)
        if parent == cur or parent == "/":
            break
        cur = parent

    # 3. Check opencode session DB for the *most recent* session in this exact directory.
    #    This handles `/agent inclusion-specialist` switches: when you Tabs-switch agents in the TUI,
    #    the session row's `agent` is updated, so the next shell tool in that same directory should
    #    route to the new agent's memory. We only look at the single most recent session for this cwd
    #    (exact match), not any recent non-system session — otherwise an old inclusion session would
    #    incorrectly shadow a newer system session.
    try:
        import sqlite3

        db_path = os.path.expanduser("~/.local/share/opencode/opencode.db")
        if os.path.exists(db_path):
            conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
            cur_db = conn.cursor()
            cur_db.execute("SELECT agent FROM session WHERE directory = ? ORDER BY time_updated DESC LIMIT 1", (cwd,))
            row = cur_db.fetchone()
            conn.close()
            if row and row[0] and row[0] != "system":
                agent = row[0]
                # Validate memory file exists or agent is known
                if agent == "inclusion-specialist":
                    return agent
                mem_path = os.path.expanduser(f"~/.config/opencode/agents/{agent}-memory.json")
                if os.path.exists(mem_path):
                    return agent
                # Even if file doesn't exist yet, still route (it will be created on init)
                return agent
    except Exception:
        pass
    return None


def _resolve_memory_path(argv):
    """Resolve MEMORY_PATH from env vars and CLI flags. Mutates argv to remove handled flags.
    Returns the resolved path and the cleaned argv."""
    global MEMORY_PATH
    path = None
    flag_given = False

    # 1. Env var OPCODE_MEMORY_PATH takes precedence over OPCODE_AGENT
    if os.environ.get("OPCODE_MEMORY_PATH"):
        path = os.path.expanduser(os.environ["OPCODE_MEMORY_PATH"])
        flag_given = True
    elif os.environ.get("OPCODE_AGENT"):
        agent = os.environ["OPCODE_AGENT"].strip()
        if agent == "system":
            path = os.path.expanduser("~/.config/opencode/agents/system-memory.json")
        else:
            # sanitize agent name to avoid path traversal
            safe = agent.replace("/", "-").replace("\\", "-")
            path = os.path.expanduser(f"~/.config/opencode/agents/{safe}-memory.json")
        flag_given = True
    else:
        path = DEFAULT_MEMORY_PATH

    # 2. CLI flags override env vars — scan argv for --agent and --memory
    cleaned = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--agent" and i + 1 < len(argv):
            agent = argv[i + 1].strip()
            if agent == "system":
                path = os.path.expanduser("~/.config/opencode/agents/system-memory.json")
            else:
                safe = agent.replace("/", "-").replace("\\", "-")
                path = os.path.expanduser(f"~/.config/opencode/agents/{safe}-memory.json")
            flag_given = True
            i += 2
            continue
        elif arg == "--memory" and i + 1 < len(argv):
            path = os.path.expanduser(argv[i + 1])
            flag_given = True
            i += 2
            continue
        elif arg.startswith("--agent="):
            agent = arg.split("=", 1)[1].strip()
            if agent == "system":
                path = os.path.expanduser("~/.config/opencode/agents/system-memory.json")
            else:
                safe = agent.replace("/", "-").replace("\\", "-")
                path = os.path.expanduser(f"~/.config/opencode/agents/{safe}-memory.json")
            flag_given = True
            i += 1
            continue
        elif arg.startswith("--memory="):
            path = os.path.expanduser(arg.split("=", 1)[1])
            flag_given = True
            i += 1
            continue
        else:
            cleaned.append(arg)
            i += 1

    # 3. Auto-detect from PWD / project / recent session if nothing explicit was given
    if not flag_given and path == DEFAULT_MEMORY_PATH:
        auto = _auto_detect_agent()
        if auto:
            if auto == "system":
                path = os.path.expanduser("~/.config/opencode/agents/system-memory.json")
            else:
                safe = auto.replace("/", "-").replace("\\", "-")
                path = os.path.expanduser(f"~/.config/opencode/agents/{safe}-memory.json")

    MEMORY_PATH = path
    return cleaned


def _load():
    if not os.path.exists(MEMORY_PATH):
        return dict(SHELL)
    with open(MEMORY_PATH, "r") as f:
        return json.load(f)


def _prune(data, silent=False):
    """Trim completed_tasks and context_notes to keep the file lean.
    Returns (tasks_removed, notes_removed)."""
    tasks_removed = 0
    notes_removed = 0

    completed = data.get("completed_tasks", [])
    if len(completed) > MAX_COMPLETED_TASKS:
        tasks_removed = len(completed) - MAX_COMPLETED_TASKS
        data["completed_tasks"] = completed[-MAX_COMPLETED_TASKS:]

    notes = data.get("context_notes", [])
    if len(notes) > MAX_CONTEXT_NOTES:
        notes_removed = len(notes) - MAX_CONTEXT_NOTES
        data["context_notes"] = notes[-MAX_CONTEXT_NOTES:]

    if (tasks_removed or notes_removed) and not silent:
        parts = []
        if tasks_removed:
            parts.append(f"{tasks_removed} old completed task(s)")
        if notes_removed:
            parts.append(f"{notes_removed} old note(s)")
        print(f"Pruned: {' and '.join(parts)} (max {MAX_COMPLETED_TASKS} tasks, {MAX_CONTEXT_NOTES} notes)")

    return tasks_removed, notes_removed


def _save(data):
    data["last_updated"] = _now()
    # ensure directory exists
    os.makedirs(os.path.dirname(MEMORY_PATH), exist_ok=True)
    with open(MEMORY_PATH, "w") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")


def _next_id(data):
    objs = data.get("active_objectives", []) + data.get("completed_tasks", [])
    existing = set()
    for o in objs:
        oid = o.get("id", "")
        if oid.startswith("obj-"):
            try:
                existing.add(int(oid[4:]))
            except ValueError:
                pass
    n = 1
    while n in existing:
        n += 1
    return f"obj-{n:03d}"


def cmd_status(data, args=None):
    print(f"=== opencode Memory [{MEMORY_PATH}] ===")
    print(f"Session count: {data.get('session_count', 0)}")
    print(f"Last updated:  {data.get('last_updated', 'never')}")
    print(f"Last session:  {data.get('last_session_end', 'never')}")
    print(f"Limits:        {MAX_COMPLETED_TASKS} max completed tasks, {MAX_CONTEXT_NOTES} max notes")
    objs = data.get("active_objectives", [])
    if objs:
        print(f"\nActive objectives ({len(objs)}):")
        for o in objs:
            status = o.get("status", "unknown")
            pri = o.get("priority", "medium")
            notes = o.get("notes", "")
            note_str = f" — {notes}" if notes else ""
            print(f"  [{status}] ({pri}) {o.get('id', '?')}: {o.get('description', '?')}{note_str}")
    else:
        print("\nNo active objectives.")
    notes = data.get("context_notes", [])
    if notes:
        print(f"\nContext notes ({len(notes)}):")
        for n in notes:
            print(f"  • {n}")
    done = data.get("completed_tasks", [])
    if done:
        print(f"\nCompleted this session: {len(done)}")


def cmd_init(data, args=None):
    if os.path.exists(MEMORY_PATH):
        print(f"Memory file already exists: {MEMORY_PATH}")
    else:
        _save(dict(SHELL))
        print(f"Initialized memory file: {MEMORY_PATH}")


def cmd_add_task(data, args):
    if not args:
        print("Error: provide a task description.")
        sys.exit(1)
    priority = "medium"
    desc_parts = []
    i = 0
    while i < len(args):
        if args[i] == "--priority" and i + 1 < len(args):
            priority = args[i + 1]
            i += 2
        else:
            desc_parts.append(args[i])
            i += 1
    desc = " ".join(desc_parts)
    if priority not in ("high", "medium", "low"):
        priority = "medium"
    oid = _next_id(data)
    task = {
        "id": oid,
        "description": desc,
        "status": "pending",
        "priority": priority,
        "created": _now(),
        "notes": "",
    }
    data.setdefault("active_objectives", []).append(task)
    _save(data)
    print(f"Added task {oid}: [{priority}] {desc} → {MEMORY_PATH}")


def cmd_update_task(data, args):
    if not args:
        print("Error: provide a task id.")
        sys.exit(1)
    tid = args[0]
    rest = args[1:]

    status_val = None
    notes_val = None
    new_args = []
    i = 0
    while i < len(rest):
        if rest[i] == "--status" and i + 1 < len(rest):
            status_val = rest[i + 1]
            i += 2
        elif rest[i] == "--notes" and i + 1 < len(rest):
            notes_val = rest[i + 1]
            i += 2
        else:
            new_args.append(rest[i])
            i += 1

    objs = data.get("active_objectives", [])
    found = None
    for o in objs:
        if o.get("id") == tid:
            found = o
            break
    if not found:
        # Check completed tasks too
        for o in data.get("completed_tasks", []):
            if o.get("id") == tid:
                found = o
                break
    if not found:
        print(f"Error: no task with id '{tid}'.")
        sys.exit(1)

    if status_val:
        found["status"] = status_val
    if notes_val:
        found["notes"] = notes_val

    _save(data)
    print(f"Updated {tid}: status={status_val or 'unchanged'}, notes={notes_val or 'unchanged'} → {MEMORY_PATH}")


def cmd_complete_task(data, args):
    if not args:
        print("Error: provide a task id.")
        sys.exit(1)
    tid = args[0]
    rest = args[1:]
    result = None
    if "--result" in rest:
        idx = rest.index("--result")
        try:
            result = " ".join(rest[idx + 1:])
            rest = rest[:idx]
        except IndexError:
            pass

    objs = data.get("active_objectives", [])
    found = None
    for i, o in enumerate(objs):
        if o.get("id") == tid:
            found = objs.pop(i)
            break
    if not found:
        print(f"Error: no active task with id '{tid}'.")
        sys.exit(1)

    found["status"] = "completed"
    completed_entry = {
        "id": found["id"],
        "summary": found["description"],
        "completed": _now(),
        "result": result or "",
    }
    data.setdefault("completed_tasks", []).append(completed_entry)
    _save(data)
    print(f"Completed {tid}: {found['description']}")


def cmd_add_note(data, args):
    if not args:
        print("Error: provide note text.")
        sys.exit(1)
    note = " ".join(args)
    data.setdefault("context_notes", []).append(note)
    _save(data)
    print(f"Added note: {note}")


def cmd_get_context(data, args=None):
    """Print a compact context block for the agent to restore from."""
    objs = data.get("active_objectives", [])
    active = [o for o in objs if o.get("status") in ("in_progress", "pending")]
    if not active:
        print("No active objectives.")
        return
    for o in active:
        pri = o.get("priority", "medium")
        notes = o.get("notes", "")
        note_str = f" — {notes}" if notes else ""
        print(f"[{o['status']}] ({pri}) {o['description']}{note_str}")


def cmd_heartbeat(data, args=None):
    _prune(data)
    _save(data)
    print(f"Heartbeat: {data['last_updated']} → {MEMORY_PATH}")


def cmd_archive(data, args=None):
    """Move all active objectives to completed_tasks (start fresh, keep history)."""
    objs = data.get("active_objectives", [])
    if not objs:
        print("No active objectives to archive.")
        return
    now = _now()
    count = 0
    for o in objs:
        entry = {
            "id": o.get("id", "?"),
            "summary": o.get("description", "?"),
            "completed": now,
            "result": "Archived on session reset",
        }
        data.setdefault("completed_tasks", []).append(entry)
        count += 1
    data["active_objectives"] = []
    _save(data)
    print(f"Archived {count} objective(s) to history. Ready for a fresh start.")


def cmd_forget(data, args=None):
    """Permanently delete all active objectives (no history kept)."""
    objs = data.get("active_objectives", [])
    if not objs:
        print("No active objectives to forget.")
        return
    count = len(objs)
    data["active_objectives"] = []
    _save(data)
    print(f"Forgot {count} objective(s). They're gone permanently.")


def cmd_prune(data, args=None):
    pruned_tasks, pruned_notes = _prune(data, silent=False)
    if pruned_tasks or pruned_notes:
        _save(data)
    else:
        print(f"Nothing to prune (under limits: {MAX_COMPLETED_TASKS} tasks, {MAX_CONTEXT_NOTES} notes)")


def cmd_close(data, args=None):
    data["last_session_end"] = _now()
    data["session_count"] = data.get("session_count", 0) + 1
    pruned_tasks, pruned_notes = _prune(data)
    _save(data)
    objs = data.get("active_objectives", [])
    active = [o for o in objs if o.get("status") in ("in_progress", "pending")]
    summary = f"Session closed. {len(active)} objectives remain."
    if pruned_tasks or pruned_notes:
        parts = []
        if pruned_tasks:
            parts.append(f"{pruned_tasks} old task(s) archived")
        if pruned_notes:
            parts.append(f"{pruned_notes} old note(s) archived")
        summary += f" ({'; '.join(parts)})"
    print(summary)


def main():
    if len(sys.argv) < 2:
        print(__doc__.strip())
        sys.exit(1)

    # Resolve memory path first, handling --agent / --memory flags + env vars
    raw_args = sys.argv[1:]
    cleaned_args = _resolve_memory_path(raw_args)

    if not cleaned_args:
        print(__doc__.strip())
        sys.exit(1)

    data = _load()
    cmd = cleaned_args[0]
    args = cleaned_args[1:]

    commands = {
        "status": cmd_status,
        "init": cmd_init,
        "add-task": cmd_add_task,
        "update-task": cmd_update_task,
        "complete-task": cmd_complete_task,
        "add-note": cmd_add_note,
        "get-context": cmd_get_context,
        "heartbeat": cmd_heartbeat,
        "close": cmd_close,
        "prune": cmd_prune,
        "archive": cmd_archive,
        "forget": cmd_forget,
    }

    if cmd not in commands:
        print(f"Unknown command: {cmd}")
        print(__doc__.strip())
        sys.exit(1)

    commands[cmd](data, args)


if __name__ == "__main__":
    main()
