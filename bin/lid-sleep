#!/bin/bash
# lid-sleep — force sleep when lid closes even in clamshell (external display connected)
# Polls AppleClamshellState via ioreg every 2s (via launchd StartInterval 2)
# When lid closed (Yes) + DELL connected, triggers pmset sleepnow (once per close)

STATE_FILE="/tmp/lid-sleep.state"
LOG_FILE="/tmp/lid-sleep.log"

# Get lid state and cause in one fast ioreg call
clamshell_info=$(ioreg -r -k AppleClamshellState -d 4 2>&1)
lid_state=$(echo "$clamshell_info" | sed -n 's/.*AppleClamshellState" = \([^ ]*\).*/\1/p' | head -n1)
if [[ -z "$lid_state" ]]; then lid_state="No"; fi
lid_cause=$(echo "$clamshell_info" | sed -n 's/.*AppleClamshellCausesSleep" = \([^ ]*\).*/\1/p' | head -n1)
if [[ -z "$lid_cause" ]]; then lid_cause="unknown"; fi

# Check if external DELL is connected (2+ displays) — use displayplacer with full PATH
dell_connected=0
if /opt/homebrew/bin/displayplacer list 2>&1 | grep -q "27 inch external screen"; then
  dell_connected=1
elif /opt/homebrew/bin/displayplacer list 2>&1 | grep -q "external screen"; then
  dell_connected=1
else
  cnt=$(/opt/homebrew/bin/displayplacer list 2>&1 | grep -c "Persistent screen id:" || true)
  if [[ "$cnt" -gt 1 ]]; then dell_connected=1; fi
fi

# Verbose log every poll for debugging lid close with external
echo "$(date '+%Y-%m-%d %H:%M:%S') poll: state=$lid_state cause=$lid_cause DELL=$dell_connected" >> "$LOG_FILE" 2>&1

# Only act when lid closed
if [[ "$lid_state" != "Yes" ]]; then
  # Lid open — reset state and exit
  echo "open" > "$STATE_FILE" 2>/dev/null || true
  exit 0
fi

# Lid is closed (Yes)
prev_state=$(cat "$STATE_FILE" 2>/dev/null || echo "open")
if [[ "$prev_state" == "closed" ]]; then
  # Already handled this close event, don't spam sleepnow
  exit 0
fi

# New close event
echo "closed" > "$STATE_FILE" 2>/dev/null || true
echo "$(date '+%Y-%m-%d %H:%M:%S') lid closed (state=$lid_state cause=$lid_cause DELL=$dell_connected) — forcing sleep" >> "$LOG_FILE" 2>&1

# Try multiple sleep methods — log each result
{
  echo "  trying pmset sleepnow..."
  pmset sleepnow 2>&1
  echo "  pmset exit:$?"
  echo "  trying osascript System Events sleep..."
  osascript -e 'tell application "System Events" to sleep' 2>&1
  echo "  osascript System Events exit:$?"
  echo "  trying osascript Finder sleep..."
  osascript -e 'tell application "Finder" to sleep' 2>&1
  echo "  osascript Finder exit:$?"
  echo "  trying pmset displaysleepnow..."
  pmset displaysleepnow 2>&1
  echo "  displaysleepnow exit:$?"
  echo "  trying sudo pmset sleepnow (if no password)..."
  sudo -n pmset sleepnow 2>&1 || echo "  sudo pmset failed (no sudo)"
  echo "  sudo exit:$?"
} >> "$LOG_FILE" 2>&1 || true

exit 0
