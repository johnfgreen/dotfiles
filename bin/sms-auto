#!/bin/bash
# sms-auto - Automatically send via Messages AppleScript (requires Automation permission)
# Usage: sms-auto <phone> <message>
# Privacy: one-time send, does not persist numbers
set -euo pipefail
if [[ $# -lt 2 ]]; then
  echo "Usage: sms-auto <phone> <message>" >&2; exit 1
fi
raw_phone="$1"; shift; body="$*"
phone="$(echo "$raw_phone" | tr -d ' -()')"
if [[ "$phone" =~ ^[0-9]{10}$ ]]; then phone="+1$phone"; elif [[ "$phone" =~ ^1[0-9]{10}$ ]]; then phone="+$phone"; fi
# Try iMessage first, then SMS - capture result to decide quit
result="$(osascript 2>&1 <<EOF
tell application "Messages"
  try
    set svc to 1st service whose service type = iMessage
    send "$body" to buddy "$phone" of svc
    return "sent iMessage"
  on error err1
    try
      set svc2 to 1st service whose service type = SMS
      send "$body" to buddy "$phone" of svc2
      return "sent SMS"
    on error err2
      return "failed: " & err1 & " / " & err2
    end try
  end try
end tell
EOF
)"
echo "$result"
# Stay logged in but quiet: quit app after successful send (keeps ZACTIVE 1, notifications OFF)
if echo "$result" | grep -q "^sent "; then
  sleep 0.5
  osascript -e 'tell application "Messages" to quit' >/dev/null 2>&1 || true
  # Also ensure background agents don't keep window open
  sleep 0.2
fi
# Propagate failure
if echo "$result" | grep -q "^failed:"; then
  exit 1
fi
